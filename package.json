{
  "name": "data-mcp-server",
  "version": "0.1.0",
  "description": "Deterministic calendar conversion and calendar-aware age calculation MCP server.",
  "private": true,
  "type": "module",
  "bin": {
    "data-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
